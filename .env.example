# FieldFix Configuration

# Choose provider: 'openrouter', 'openai', 'gemini', 'anthropic', or 'mock'
LLM_PROVIDER=openrouter

# API Keys (set the key for your selected provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Names
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Embedding Model: 'text-embedding-3-small' (OpenAI) or 'tfidf-dense' (local fallback)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Retrieval Settings
TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
